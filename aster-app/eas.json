{
  "cli": { "version": ">=7.0.0" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_USE_DEV_SERVER": "true" },
      "ios": { "resourceClass": "m-medium", "simulator": false }
    },
    "adhoc": {
      "ios": {
        "distribution": "internal",
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": { "simulator": false }
    },
    "production": {
      "distribution": "store",
      "ios": { "simulator": false }
    }
  },
  "submit": {
    "production": {}
  }
}