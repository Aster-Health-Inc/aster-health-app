{
  "expo": {
    "sdkVersion": "54.0.0",
    "name": "aster-app",
    "slug": "aster-app",
    "scheme": "aster",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aster.healthapp",
       "entitlements": {
        "com.apple.developer.healthkit": true,
        "usesAppleSignIn": true
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "This app needs access to camera to take photos for nutrition analysis.",
        "NSHealthShareUsageDescription": "We read your Health data to show insights and trends.",
        "NSHealthUpdateUsageDescription": "We write workouts and metrics you log in the app."      
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "CAMERA",
        "CAMERA"
      ],
      "package": "com.y"
    },
    "plugins": [
      "expo-font"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "asterhealth",
    "extra": {
      "eas": {
        "projectId": "c220f578-b1ce-41ff-971c-88e90f13c7e5"
      }
    }
  }
}
