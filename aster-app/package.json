{
  "name": "aster-app",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "tunnel": "expo start --tunnel",
    "clear": "expo start --clear",
    "build:ios": "expo export --platform ios",
    "build:android": "expo export --platform android",
    "start:ios": "EXPO_NO_OSASCRIPT=1 REACT_NATIVE_DISABLE_WATCHMAN=1 expo start --dev-client --host localhost --port 8081 -c",
    "sim:boot": "open -a Simulator && xcrun simctl boot 'iPhone 16 Pro' || true",
    "sim:install": "expo run:ios --device 'iPhone 16 Pro'",
    "sim:openurl": "xcrun simctl openurl booted 'exp+aster-app://expo-development-client/?url=exp%3A%2F%2F127.0.0.1%3A8081'",
    "ios-sim": "npm run sim:boot && npm run sim:install && npm run sim:openurl",
    "lint": "eslint . --ext .js,.jsx",
    "lint:fix": "eslint . --ext .js,.jsx --fix",
    "format": "prettier --write .",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-community/slider": "5.0.1",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/bottom-tabs": "^7.4.6",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/stack": "^7.4.7",
    "@supabase/supabase-js": "^2.51.0",
    "ansi-escapes": "^7.0.0",
    "date-fns": "^4.1.0",
    "expo": "~54.0.33",
    "expo-application": "~7.0.8",
    "expo-auth-session": "~7.0.10",
    "expo-av": "~16.0.8",
    "expo-blur": "~15.0.7",
    "expo-constants": "~18.0.9",
    "expo-dev-client": "~6.0.15",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.8",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.8",
    "expo-linear-gradient": "~15.0.7",
    "expo-linking": "~8.0.11",
    "expo-localization": "~17.0.8",
    "expo-modules-core": "~3.0.29",
    "expo-notifications": "~0.32.12",
    "expo-sensors": "~15.0.7",
    "expo-status-bar": "~3.0.8",
    "expo-web-browser": "~15.0.10",
    "jose": "^6.1.0",
    "posthog-react-native": "^4.14.3",
    "posthog-react-native-session-replay": "^1.2.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@react-native/eslint-config": "^0.74.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.7.2",
    "@types/react": "~19.1.10",
    "baseline-browser-mapping": "^2.9.7",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.34.3",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "prettier": "^3.3.3",
    "react-test-renderer": "19.1.0"
  },
  "private": true,
  "overrides": {
    "@expo/fingerprint": "0.15.0"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "@testing-library/jest-native/extend-expect",
      "<rootDir>/jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ]
  }
}
